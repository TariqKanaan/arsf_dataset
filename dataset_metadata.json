{
  "dataset_name": "ARSF synthetic OFDM spectrum-sensing dataset",
  "seed": 42,
  "n_carriers": 64,
  "cyclic_prefix_length": 16,
  "symbol_length": 80,
  "cfo_fraction_range": [
    -0.1,
    0.1
  ],
  "phase_noise_wiener_variance": 1e-05,
  "iq_amplitude_imbalance_std": 0.02,
  "iq_phase_imbalance_std_rad": 0.017453292519943295,
  "noise_variance_nominal": 1.0,
  "noise_variance_sampling": "log-uniform on [sigma0_squared/rho, rho*sigma0_squared], rho=10^(Delta_dB/10)",
  "channel": "single complex Rayleigh fading coefficient per H1 observation, CN(0,1)",
  "modulation": "random QPSK OFDM with cyclic prefix",
  "labels": {
    "0": "H0: noise only",
    "1": "H1: impaired OFDM signal plus noise"
  },
  "split_sizes": {
    "train": 600,
    "validation": 400,
    "test": 600
  },
  "balanced_classes": true,
  "snr_grid_db": [
    -20.0,
    -18.0,
    -16.0,
    -14.0,
    -12.0,
    -10.0,
    -8.0,
    -6.0,
    -4.0,
    -2.0,
    0.0
  ],
  "delta_grid_db": [
    0.0,
    0.5,
    1.0,
    1.5,
    2.0,
    3.0
  ],
  "default_n_samples": 1024,
  "include_sample_size_grid": false,
  "sample_size_grid": null,
  "repeats": 1,
  "stable_seed_note": "Cell seeds use SHA-256-based keys for reproducibility across separate Python processes.",
  "file_format": "Compressed NumPy NPZ; IQ arrays are complex64, label arrays are int32."
}